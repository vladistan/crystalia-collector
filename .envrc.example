# AWS Configuration
export AWS_PROFILE=default
export AWS_DEFAULT_REGION=us-east-1

# Sentry — optional. Leave SENTRY_DSN empty to use the project default DSN (when enable_telemetry=true).
# Set to your own DSN to redirect telemetry, or disable entirely with enable_telemetry=false.
export SENTRY_DSN=
export CRYSTALIA_ENABLE_TELEMETRY=true

# Application settings (can also be set in crystalia.toml or ~/.config/crystalia-collector/config.toml)
export CRYSTALIA_DEFAULT_METHOD_ID=md5-8gb
export CRYSTALIA_DEFAULT_OUTPUT_FILE=out.rdf
export CRYSTALIA_LOG_JSON=true
